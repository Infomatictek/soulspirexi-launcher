<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SoulspireLauncher</AssemblyName>
    <RootNamespace>SoulspireLauncher</RootNamespace>
    <Version>2.2.2</Version>
    <FileVersion>2.2.2.0</FileVersion>
    <AssemblyVersion>2.2.2.0</AssemblyVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>SoulspireXI Launcher</AssemblyTitle>
    <Product>SoulspireXI Launcher</Product>
    <Company>SoulspireXI</Company>
    <Authors>SoulspireXI</Authors>
    <Copyright>Copyright © SoulspireXI</Copyright>
    <Description>Official Ashita v4 client launcher and auto-updater for SoulspireXI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\manifest.json" Link="Resources\manifest.json" />
    <EmbeddedResource Include="..\keys\soulspire-launcher-release-v1.pub.pem" LogicalName="SoulspireLauncher.Resources.release-signing-public.pem" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
