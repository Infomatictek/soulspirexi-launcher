<Window x:Class="SoulspireLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoulspireXI Launcher"
        Width="1040"
        Height="700"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource AbyssBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" />
                    <TextBlock Text="SOULSPIREXI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource GoldAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="  •  LAUNCHER  •  " FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LauncherVersionText}" FontSize="12" Foreground="{StaticResource CyanAccent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Background="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBadgeBg}}"
                            BorderBrush="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBrush}}"
                            BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChannelBadgeText}" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBrush}}" />
                    </Border>
                    <Border Visibility="{Binding IsStagingMode, Converter={StaticResource BoolToVis}}"
                            Background="#33220B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"
                            Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STAGING SERVER" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="44" Height="44" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0" FontSize="14" Cursor="Hand" Click="MinimizeClick" />
                    <Button Content="✕" Width="46" Height="44" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0" FontSize="13" Cursor="Hand" Click="CloseClick" />
                </StackPanel>
            </Grid>

            <!-- Navigation + Server Status Header -->
            <Border Grid.Row="1" Background="{StaticResource MidnightBrush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="PLAY" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Play" Tag="{Binding IsPlayTab}" Margin="0,0,6,0" />
                        <Button Content="GRAPHICS &amp; SETTINGS" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Settings" Tag="{Binding IsSettingsTab}" Margin="0,0,6,0" />
                        <Button Content="SETUP &amp; DIAGNOSTICS" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Setup" Tag="{Binding IsSetupTab}" Margin="0,0,6,0" />
                        <Button Content="IN-GAME GUIDE" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Guide" Tag="{Binding IsGuideTab}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AbyssBrush}"
                                BorderBrush="{Binding IsStagingMode, Converter={StaticResource BoolToStagingBorderBrush}}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding ServerStatus.IsOnline, Converter={StaticResource BoolToStatusBrush}}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ServerStatusDisplayHost}" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ServerStatus.SummaryText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Button Content="↻" ToolTip="Refresh Server Status" Style="{StaticResource SecondaryButton}" Padding="10,5" Command="{Binding RefreshStatusCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Tab Content -->
            <Grid Grid.Row="2" Margin="20,16">

                <!-- TAB 1: PLAY -->
                <Grid Visibility="{Binding IsPlayTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="24,20" Margin="0,0,0,16" BorderBrush="{StaticResource VioletAccent}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#151928" Offset="0" />
                                <GradientStop Color="#191933" Offset="0.55" />
                                <GradientStop Color="#0E1D2A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/app.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,18,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ServerName}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" />
                                    <TextBlock Text="{Binding Tagline}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBadgeBg}}"
                                                BorderBrush="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBrush}}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding UpdateBadgeText}" FontSize="12" Foreground="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBrush}}" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{StaticResource AbyssBrush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding ManifestVersionText}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                        <Border Visibility="{Binding IsStagingMode, Converter={StaticResource BoolToVis}}"
                                                Background="#33220B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StagingHeaderBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="{Binding PlayButtonText}" Style="{StaticResource PrimaryPlayButton}" Command="{Binding PlayCommand}" MinWidth="220" />
                                <Button Content="Check / Sync Updates" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdatesCommand}" Margin="0,8,0,0" />
                                <Button Content="{Binding LauncherUpdateButtonText}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ApplyLauncherUpdateCommand}"
                                        Visibility="{Binding IsLauncherUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Foreground="{StaticResource GoldAccent}" BorderBrush="{StaticResource GoldAccent}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Two Columns: Account Launch + News/Log -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Account & Quick Options -->
                        <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ACCOUNT &amp; LAUNCH" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />

                                    <TextBlock Text="Server Environment" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ServerTargetOptions}" SelectedItem="{Binding SelectedServerTarget}" Margin="0,0,0,10">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ServerTargetToLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Border Visibility="{Binding IsStagingMode, Converter={StaticResource BoolToVis}}"
                                            Background="#2A1D0A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StagingCardHeaderText}" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24" />
                                            <TextBlock Text="Staging Lane" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,3" />
                                            <ComboBox ItemsSource="{Binding StagingLaneOptions}" SelectedItem="{Binding SelectedStagingLane}" Margin="0,0,0,6">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource StagingLaneToLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding StagingTargetSummaryText}" FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StagingRelayStatusText}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Switch Back to Production" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding SelectProductionServerCommand}" Padding="10,5" FontSize="11.5" />
                                                <Button Content="Stop Relay" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding StopStagingRelayCommand}"
                                                        Visibility="{Binding IsStagingRelayActive, Converter={StaticResource BoolToVis}}"
                                                        Padding="10,5" FontSize="11.5" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Username (optional)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                    <TextBlock Text="Password (optional)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="AccountPasswordBox" PasswordChanged="AccountPasswordBox_OnPasswordChanged" Margin="0,0,0,10" />

                                    <CheckBox Content="Remember password (Windows DPAPI encrypted)" IsChecked="{Binding RememberPassword}" />
                                    <CheckBox Content="Auto-login via xiloader arguments" IsChecked="{Binding AutoLogin}" />
                                    <CheckBox Content="Auto-load soulspire_talents (/talents)" IsChecked="{Binding AutoLoadTalentsAddon}" />
                                    <CheckBox Content="Auto-load crystalsocket (Equipment Soul Crystal UI)" IsChecked="{Binding AutoLoadCrystalSocketAddon}" />
                                    <CheckBox Content="Auto-load metrics DPS parser (/metrics)" IsChecked="{Binding AutoLoadMetricsAddon}" />
                                    <CheckBox Content="Auto-load checker (/check exact mob levels)" IsChecked="{Binding AutoLoadCheckerAddon}" />
                                    <CheckBox Content="Auto-load mobdb (Target level, aggro &amp; info)" IsChecked="{Binding AutoLoadMobDbAddon}" />
                                    <CheckBox Content="Auto-load kazenoeye (Debuffs &amp; HP over mobs)" IsChecked="{Binding AutoLoadKazenoeyeAddon}" />
                                    <CheckBox Content="Auto-load soulspire_gear (/og Gear Manager)" IsChecked="{Binding AutoLoadGearAddon}" />
                                    <CheckBox Content="Auto-load soulspire_soulhud (/soulhud Crystal Job Gauge + Chi Weaver Boost)" IsChecked="{Binding AutoLoadSoulHudAddon}" />
                                    <CheckBox Content="Enable Pivot DAT overlay (Call Eos)" IsChecked="{Binding EnablePivotOverlay}" />
                                    <CheckBox Content="Enable Flintlock Dual Pistols DAT overlay (75% compact, COR Flintlock opt-in)" IsChecked="{Binding EnableFlintlockDualPistolsOverlay}" IsEnabled="{Binding EnablePivotOverlay}" />
                                    <CheckBox Content="Close launcher when game starts" IsChecked="{Binding AutoCloseOnLaunch}" />

                                    <Border Background="{StaticResource AbyssBrush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                        <TextBlock Text="First time joining? Leave Auto-login unchecked to create your account directly inside the xiloader console window."
                                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Column: News + Activity Log -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="175" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PATCH NOTES &amp; ANNOUNCEMENTS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding NewsItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" />
                                                                <TextBlock Text="{Binding Date}" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource CyanAccent}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ACTIVITY LOG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" Background="{StaticResource AbyssBrush}" Foreground="{StaticResource TextSecondary}"
                                             BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" FontFamily="Consolas" FontSize="11.5" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- TAB 2: GRAPHICS & SETTINGS -->
                <ScrollViewer Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Settings Column: Connection + Paths -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="SERVER CONNECTION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />

                                        <TextBlock Text="Server Environment" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding ServerTargetOptions}" SelectedItem="{Binding SelectedServerTarget}" Margin="0,0,0,10">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ServerTargetToLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Staging Server Configuration (zero-privilege loopback TCP relay) -->
                                        <Border Visibility="{Binding IsStagingMode, Converter={StaticResource BoolToVis}}"
                                                Background="#2A1D0A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="STAGING SERVER (MANAGED LOCAL TCP RELAY)" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,4" />
                                                <TextBlock Text="Forwards xiloader's fixed local TCP ports (54231/54230/54001/54002/51220/51240) to Staging's alternate ports in-process. No admin prompt, no netsh portproxy edits, and Production stays isolated."
                                                           FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                <TextBlock Text="Staging Lane" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding StagingLaneOptions}" SelectedItem="{Binding SelectedStagingLane}" Margin="0,0,0,8">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource StagingLaneToLabel}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBlock Text="Staging Host / IP" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding StagingServerHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                                    <StackPanel Margin="0,0,6,6">
                                                        <TextBlock Text="Auth TCP (54231)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding StagingAuthPort}" Padding="6,5" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Margin="3,0,3,6">
                                                        <TextBlock Text="Data TCP (54230)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding StagingDataPort}" Padding="6,5" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,0,6">
                                                        <TextBlock Text="View TCP (54001)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding StagingViewPort}" Padding="6,5" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Search TCP (54002)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding StagingSearchPort}" Padding="6,5" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="Profile TCP (51220)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding StagingProfilePort}" Padding="6,5" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,0,0">
                                                        <TextBlock Text="Profile IRC (51240)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding StagingProfileIrcPort}" Padding="6,5" FontSize="12" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock Text="{Binding StagingRelayStatusText}" FontSize="11" Foreground="{StaticResource CyanAccent}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Reset Staging Defaults" Style="{StaticResource SecondaryButton}" Command="{Binding ResetStagingDefaultsCommand}" Padding="10,5" FontSize="11.5" />
                                                    <Button Content="Stop Relay" Style="{StaticResource SecondaryButton}" Command="{Binding StopStagingRelayCommand}" Padding="10,5" FontSize="11.5" Margin="6,0,0,0" />
                                                    <Button Content="Back to Production" Style="{StaticResource SecondaryButton}" Command="{Binding SelectProductionServerCommand}" Padding="10,5" FontSize="11.5" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Custom Server Configuration (Preserved) -->
                                        <StackPanel Visibility="{Binding IsCustomServerMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Custom Server Host / IP" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding CustomServerHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                            <CheckBox Content="Pass --hairpin to xiloader (for external/NAT connections)" IsChecked="{Binding CustomUseHairpin}" Margin="0,0,0,8" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Lobby TCP Port" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding CustomLobbyPort}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Search TCP Port" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding CustomSearchPort}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <Button Content="Export Shareable soulspire-server.json" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ExportServerOverrideCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="PATHS &amp; OVERLAY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />

                                        <TextBlock Text="FINAL FANTASY XI Folder" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding FfxiPath}" />
                                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFfxiCommand}" />
                                        </Grid>

                                        <TextBlock Text="Ashita v4 Folder" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AshitaPath}" />
                                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseAshitaCommand}" />
                                            <Button Grid.Column="4" Content="Default" ToolTip="Use Ashita folder next to launcher" Style="{StaticResource SecondaryButton}" Command="{Binding ResetAshitaPathCommand}" />
                                            <Button Grid.Column="6" Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding OpenAshitaFolderCommand}" />
                                        </Grid>

                                        <CheckBox Content="Also copy DAT overlay to external folder (e.g. C:\DATs\Soulspire)" IsChecked="{Binding SyncToCustomDatFolder}" />
                                        <Grid IsEnabled="{Binding SyncToCustomDatFolder}" Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CustomDatOverlayPath}" />
                                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCustomDatCommand}" />
                                        </Grid>

                                        <CheckBox Content="Check for SoulspireXI updates on startup" IsChecked="{Binding AutoCheckUpdatesOnStartup}" />
                                        <CheckBox Content="Auto-update SoulspireLauncher.exe on startup" IsChecked="{Binding AutoUpdateLauncher}" />

                                        <Border Background="{StaticResource AbyssBrush}" BorderBrush="{Binding SelectedUpdateChannel, Converter={StaticResource ChannelToBrush}}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                            <StackPanel>
