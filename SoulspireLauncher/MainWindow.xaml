                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Selected Channel:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeSelectedChannel}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Expected DLL SHA-256:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeExpectedDllSha256}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Installed DLL SHA-256:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeInstalledDllSha256}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.NativeDllSha256Status}" Foreground="{Binding Diagnostics.NativeDllSha256Status, Converter={StaticResource DiagStatusToBrush}}" FontWeight="Bold" FontSize="11.5" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DLL Architecture:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeDllArchitecture}" FontSize="11.5" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.NativeDllArchitectureStatus}" Foreground="{Binding Diagnostics.NativeDllArchitectureStatus, Converter={StaticResource DiagStatusToBrush}}" FontWeight="Bold" FontSize="11.5" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Registry Compiled Hash:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeRegistryCompiledHash}" FontFamily="Consolas" FontSize="11" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Native Hook Count:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeHookCount}" FontSize="11.5" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DLL File Location:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeDllFilePath}" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Loaded Module (pol.exe):" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnostics.NativeLoadedModuleDetail}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.NativeLoadedModuleStatus}" Foreground="{Binding Diagnostics.NativeLoadedModuleStatus, Converter={StaticResource DiagStatusToBrush}}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Top" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Force Re-Sync All SoulspireXI Files" Style="{StaticResource SecondaryButton}" Command="{Binding RepairFilesCommand}" Margin="0,0,10,0" />
                                    <Button Content="Check Launcher Update" Style="{StaticResource SecondaryButton}" Command="{Binding CheckLauncherUpdateCommand}" Margin="0,0,10,0" />
                                    <Button Content="Create Desktop Shortcut" Style="{StaticResource SecondaryButton}" Command="{Binding CreateDesktopShortcutCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 4: IN-GAME GUIDE -->
                <ScrollViewer Visibility="{Binding IsGuideTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="WEAPONSKILL TALENT TREES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,12">
                                    All 207 player weaponskills are unlocked at level 1 and scale via 4-tier (56-point) bespoke job-themed talent trees and pickable skillchain augments.
                                </TextBlock>
                                <Border Background="{StaticResource AbyssBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="/talents  (or /tal) — Open the Ashita v4 Talent Tree UI" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource CyanAccent}" Margin="0,0,0,4" />
                                        <TextBlock Text="/talents sync — Force resync points &amp; catalog from server" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="!talent — Server-side fallback menu without the addon" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="SCHOLAR: CALL EOS &amp; SPECS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,6,0,8" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,12">
                                    Call Eos summons a real faerie pet that maintains stackable Regen and removes debuffs (-na / Erase). Equip Orphic Egg for level-scaling Eos Refresh.
                                </TextBlock>
                                <Border Background="{StaticResource AbyssBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="!spec  /  !spec list — View available job specs" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource CyanAccent}" Margin="0,0,0,4" />
                                        <TextBlock Text="!spec set medic — AoE Cure/Regen + double Sublimation" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="!spec set sage — Permanent Ebullience + 2h boosted Helix" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="!eos heal  /  !eos dismiss — Control Eos manually" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="FIRST-TIME PLAYER CHECKLIST" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    1. Ensure FINAL FANTASY XI is installed and patched on your PC.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    2. Enable Windows DirectPlay (Turn Windows features on or off -> Legacy Components -> DirectPlay).
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    3. Click PLAY SOULSPIREXI — the launcher automatically downloads Ashita v4, xiloader.exe, XIPivot, the SoulspireXI DAT overlay, and all default addons if missing.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    4. On your first launch, leave Auto-login unchecked and choose option 2 in xiloader to create an account on the server.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,14">
                                    5. For the best alt-tab stability on Windows 10/11, keep Window Mode set to Borderless or Windowed.
                                </TextBlock>

                                <TextBlock Text="QOL ADDONS &amp; COMMANDS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,8" />
                                <Border Background="{StaticResource AbyssBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="/check (checker) — Shows exact mob level, eva &amp; def" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource CyanAccent}" Margin="0,0,0,4" />
                                        <TextBlock Text="/mobdb (or /md) — Configure target level &amp; aggro bar" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="/kazenoeye (/ke) — Customize mob HP &amp; debuff HUD" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="/metrics — Open/configure the DPS combat parser" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Status & Progress Footer -->
            <Border Grid.Row="3" Background="{StaticResource AbyssBrush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Background="{StaticResource MidnightBrush}" Foreground="{StaticResource CyanAccent}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
